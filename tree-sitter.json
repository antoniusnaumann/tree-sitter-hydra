{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "hydra",
      "camelcase": "Hydra",
      "scope": "source.hydra",
      "path": ".",
      "file-types": [
        "hy"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Hydra grammar for tree-sitter",
    "authors": [
      {
        "name": "Antonius Naumann"
      }
    ],
    "links": {
      "repository": "https://github.com/antoniusnaumann/tree-sitter-hydra"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
